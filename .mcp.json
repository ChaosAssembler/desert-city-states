{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "exec",
        "--",
        "playwright-mcp",
        "--browser",
        "firefox"
      ],
      "env": {}
    },
    "dcs": {
      "type": "stdio",
      "command": "cargo",
      "args": ["run", "-p", "dcs-mcp"],
      "env": {}
    }
  }
}