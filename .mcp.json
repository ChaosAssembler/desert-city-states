{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "firefox"
      ],
      "env": {}
    },
    "dcs": {
      "type": "stdio",
      "command": "cargo",
      "args": ["run", "-p", "dcs-mcp"],
      "env": {}
    }
  }
}