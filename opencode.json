{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "subagent_depth": 2,
  "plugin": ["opencode-pty"],
  "mcp": {
    "dcs": {
      "type": "local",
      "command": ["cargo", "run", "--bin", "dcs-mcp"],
      "enabled": true
    }
  },
  "permission": {
    "*": "deny",
    "todowrite": "allow"
  },
  "agent": {
    "general": {
      "disable": true
    }
  }
}